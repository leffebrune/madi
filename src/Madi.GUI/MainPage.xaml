<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Madi.GUI.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Madi.GUI"
    xmlns:presentation="using:Madi.GUI.Presentation"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Page.Resources>
        <local:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <local:CountToVisibilityConverter x:Key="CountToVisibility" />
        <local:NavigationIndentConverter x:Key="NavigationIndent" />
        <local:HeaderWeightConverter x:Key="HeaderWeight" />
        <local:TimelineBrushConverter x:Key="TimelineBrush" />
        <local:TimelineAlignmentConverter x:Key="TimelineAlignment" />

        <DataTemplate x:Key="NavigationTemplate" x:DataType="presentation:NavigationItemViewModel">
            <Grid Margin="{Binding Indent, Converter={StaticResource NavigationIndent}}"
                  Padding="6,2"
                  ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Title}"
                           VerticalAlignment="Center"
                           FontWeight="{Binding IsHeader, Converter={StaticResource HeaderWeight}}"
                           TextTrimming="CharacterEllipsis"
                           AutomationProperties.Name="{Binding Title}" />
                <Button Grid.Column="1"
                        Width="28"
                        Height="28"
                        Padding="0"
                        Click="OnSessionMenuClick"
                        Visibility="{Binding IsHeader, Converter={StaticResource InverseBoolToVisibility}}"
                        ToolTipService.ToolTip="대화 메뉴"
                        AutomationProperties.Name="대화 메뉴">
                    <FontIcon Glyph="&#xE712;" FontSize="12" />
                </Button>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SuggestionTemplate" x:DataType="presentation:SuggestionItemViewModel">
            <TextBlock Text="{Binding DisplayText}" TextTrimming="CharacterEllipsis" />
        </DataTemplate>

        <DataTemplate x:Key="TimelineTemplate" x:DataType="presentation:TimelineItemViewModel">
            <Border MaxWidth="920"
                    Margin="12,5"
                    Padding="14,10"
                    CornerRadius="10"
                    HorizontalAlignment="{Binding Kind, Converter={StaticResource TimelineAlignment}}"
                    Background="{Binding Kind, Converter={StaticResource TimelineBrush}}">
                <StackPanel Spacing="7">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding RoleLabel}" FontWeight="SemiBold" />
                        <ProgressRing Width="14" Height="14"
                                      IsActive="{Binding IsRunning}"
                                      Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <local:MarkdownView Markdown="{Binding Text}" />
                    <Expander Header="상세"
                              Visibility="{Binding HasDetails, Converter={StaticResource BoolToVisibility}}">
                        <local:MarkdownView Margin="0,8,0,0" Markdown="{Binding Details}" />
                    </Expander>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid x:Name="WorkspacePanel" Padding="40" MaxWidth="760" HorizontalAlignment="Center">
            <StackPanel VerticalAlignment="Center" Spacing="18">
                <FontIcon Glyph="&#xE8B7;" FontSize="44" HorizontalAlignment="Left" />
                <TextBlock Text="작업공간 선택" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Madi가 파일을 읽고 도구를 실행할 프로젝트 폴더를 선택하세요. 작업공간별로 대화가 분리됩니다."
                           TextWrapping="Wrap" Opacity="0.75" />
                <ListView x:Name="RecentWorkspaceList"
                          MinHeight="120"
                          MaxHeight="300"
                          SelectionMode="Single"
                          DoubleTapped="OnRecentWorkspaceDoubleTapped"
                          AutomationProperties.Name="최근 작업공간" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="선택한 폴더 열기" Click="OnOpenRecentWorkspace" />
                    <Button Content="다른 폴더 찾아보기" Click="OnBrowseWorkspace" />
                </StackPanel>
                <InfoBar x:Name="WorkspaceError" Severity="Error" IsOpen="False" IsClosable="True" />
            </StackPanel>
        </Grid>

        <Grid x:Name="Shell" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    BorderThickness="0,0,1,0"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid Padding="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="대화" FontSize="20" FontWeight="SemiBold" Margin="6,6,6,12" />
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                        <Button Content="새 대화" Click="OnNewSession"
                                IsEnabled="{Binding CanInteract}"
                                AutomationProperties.Name="새 대화 만들기" />
                        <Button Content="새 Work" Click="OnNewWork"
                                IsEnabled="{Binding CanInteract}"
                                AutomationProperties.Name="새 Work 만들기" />
                    </StackPanel>
                    <ListView x:Name="NavigationList"
                              Grid.Row="2"
                              ItemsSource="{Binding NavigationItems}"
                              ItemTemplate="{StaticResource NavigationTemplate}"
                              IsItemClickEnabled="True"
                              ItemClick="OnNavigationItemClick"
                              SelectionMode="Single"
                              IsEnabled="{Binding CanInteract}"
                              AutomationProperties.Name="작업공간 대화 목록" />
                    <Button Grid.Row="3" Content="작업공간 변경" Click="OnChangeWorkspace"
                            IsEnabled="{Binding CanInteract}" HorizontalAlignment="Stretch" />
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Padding="18,12" BorderThickness="0,0,0,1"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="240" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding HeaderTitle}" FontSize="20" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding WorkingDirectory}" FontSize="12" Opacity="0.65"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <ComboBox x:Name="ModelSelector" Grid.Column="1"
                                  ItemsSource="{Binding Models}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Name"
                                  SelectedValue="{Binding SelectedModelName, Mode=OneWay}"
                                  SelectionChanged="OnModelSelectionChanged"
                                  IsEnabled="{Binding CanInteract}"
                                  Header="모델"
                                  AutomationProperties.Name="모델 선택" />
                        <Button Grid.Column="2"
                                Content="{Binding AuthenticationLabel}"
                                Click="OnToggleAuthentication"
                                IsEnabled="{Binding CanInteract}"
                                VerticalAlignment="Bottom"
                                AutomationProperties.Name="로그인 상태" />
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1">
                    <InfoBar IsOpen="{Binding HasError, Mode=OneWay}"
                             Message="{Binding ErrorText}"
                             Severity="Error"
                             IsClosable="True"
                             CloseButtonClick="OnErrorClosed" />
                    <InfoBar x:Name="LegacyInfoBar"
                             Title="기존 대화 발견"
                             Message="작업공간 정보가 없는 기존 데이터를 현재 폴더에 연결할 수 있습니다."
                             Severity="Informational"
                             IsOpen="False"
                             IsClosable="True">
                        <InfoBar.ActionButton>
                            <Button Content="현재 작업공간에 연결" Click="OnImportLegacyData" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                </StackPanel>

                <Grid Grid.Row="2">
                    <ListView x:Name="TimelineList"
                              ItemsSource="{Binding Timeline}"
                              ItemTemplate="{StaticResource TimelineTemplate}"
                              SelectionMode="None"
                              HorizontalContentAlignment="Stretch"
                              AutomationProperties.Name="대화 타임라인">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsStackPanel ItemsUpdatingScrollMode="KeepLastItemInView" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                    </ListView>
                    <Button x:Name="LatestButton"
                            Content="최신으로 이동"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,12"
                            Click="OnGoLatest"
                            Visibility="Collapsed" />
                </Grid>

                <Grid Grid.Row="3" Padding="16,8,16,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ListView x:Name="SuggestionList"
                              ItemsSource="{Binding Suggestions}"
                              ItemTemplate="{StaticResource SuggestionTemplate}"
                              SelectionMode="Single"
                              MaxHeight="160"
                              Visibility="{Binding Suggestions.Count, Converter={StaticResource CountToVisibility}}"
                              DoubleTapped="OnSuggestionDoubleTapped" />
                    <Grid Grid.Row="1" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="PromptBox"
                                 Text="{Binding Draft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="48"
                                 MaxHeight="150"
                                 PlaceholderText="Madi에게 작업을 요청하세요"
                                 KeyDown="OnPromptKeyDown"
                                 AutomationProperties.Name="프롬프트 입력">
                            <TextBox.KeyboardAccelerators>
                                <KeyboardAccelerator Key="Enter"
                                                     Modifiers="Control"
                                                     Invoked="OnPromptSendAcceleratorInvoked" />
                            </TextBox.KeyboardAccelerators>
                        </TextBox>
                        <Button Grid.Column="1"
                                Content="{Binding SendButtonText}"
                                Click="OnSendOrCancel"
                                MinWidth="76"
                                VerticalAlignment="Stretch"
                                AutomationProperties.Name="전송 또는 취소" />
                    </Grid>
                </Grid>
            </Grid>

            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="Wide" />
                    <VisualState x:Name="Narrow">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="SidebarColumn.Width" Value="220" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Normal">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="1000" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="SidebarColumn.Width" Value="280" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>
    </Grid>
</Page>
