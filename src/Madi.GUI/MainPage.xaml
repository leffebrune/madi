<Page x:Class="Madi.GUI.MainPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
 <Grid>        <Grid x:Name="WorkspacePanel" Padding="40" MaxWidth="760" HorizontalAlignment="Center">
            <StackPanel VerticalAlignment="Center" Spacing="18">
                <FontIcon Glyph="&#xE8B7;" FontSize="44" HorizontalAlignment="Left" />
                <TextBlock Text="작업공간 선택" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Madi가 파일을 읽고 도구를 실행할 프로젝트 폴더를 선택하세요. 작업공간별로 대화가 분리됩니다."
                           TextWrapping="Wrap" Opacity="0.75" />
                <ListView x:Name="RecentWorkspaceList"
                          MinHeight="120"
                          MaxHeight="300"
                          SelectionMode="Single"
                          DoubleTapped="OnRecentWorkspaceDoubleTapped"
                          AutomationProperties.Name="최근 작업공간" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="선택한 폴더 열기" Click="OnOpenRecentWorkspace" />
                    <Button Content="다른 폴더 찾아보기" Click="OnBrowseWorkspace" />
                </StackPanel>
                <InfoBar x:Name="WorkspaceError" Severity="Error" IsOpen="False" IsClosable="True" />
            </StackPanel>
        </Grid>

    <Grid x:Name="WorkspaceShell" Visibility="Collapsed">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <InfoBar x:Name="ShellError" IsOpen="False" Severity="Error" IsClosable="True" />
      <TabView x:Name="Tabs" Grid.Row="1" TabWidthMode="SizeToContent"
               VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
               HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
               AddTabButtonClick="OnAddTab" SelectionChanged="OnTabSelected"
               TabCloseRequested="OnTabCloseRequested" AutomationProperties.Name="작업 탭" />
    </Grid>
 </Grid>
</Page>
