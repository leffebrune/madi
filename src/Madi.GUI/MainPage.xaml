<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Madi.GUI.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    xmlns:local="using:Madi.GUI"
    xmlns:presentation="using:Madi.GUI.Presentation"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Page.Resources>
        <local:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <local:CountToVisibilityConverter x:Key="CountToVisibility" />
        <local:NavigationIndentConverter x:Key="NavigationIndent" />
        <local:HeaderWeightConverter x:Key="HeaderWeight" />
        <local:TimelineBrushConverter x:Key="TimelineBrush" />
        <local:TimelineAlignmentConverter x:Key="TimelineAlignment" />

        <DataTemplate x:Key="NavigationTemplate" x:DataType="presentation:NavigationItemViewModel">
            <Grid Margin="{Binding Indent, Converter={StaticResource NavigationIndent}}"
                  Padding="6,2"
                  ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Title}"
                           VerticalAlignment="Center"
                           FontWeight="{Binding IsHeader, Converter={StaticResource HeaderWeight}}"
                           TextTrimming="CharacterEllipsis"
                           AutomationProperties.Name="{Binding Title}" />
                <Button Grid.Column="1"
                        Width="28"
                        Height="28"
                        Padding="0"
                        Click="OnSessionMenuClick"
                        Visibility="{Binding IsHeader, Converter={StaticResource InverseBoolToVisibility}}"
                        ToolTipService.ToolTip="대화 메뉴"
                        AutomationProperties.Name="대화 메뉴">
                    <FontIcon Glyph="&#xE712;" FontSize="12" />
                </Button>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SuggestionTemplate" x:DataType="presentation:SuggestionItemViewModel">
            <TextBlock Text="{Binding DisplayText}" TextTrimming="CharacterEllipsis" />
        </DataTemplate>

        <DataTemplate x:Key="TimelineTemplate" x:DataType="presentation:TimelineItemViewModel">
            <Border Width="1200"
                    Margin="12,5"
                    Padding="14,10"
                    CornerRadius="10"
                    HorizontalAlignment="{Binding Kind, Converter={StaticResource TimelineAlignment}}"
                    Background="{Binding Kind, Converter={StaticResource TimelineBrush}}">
                <StackPanel Spacing="7">
                    <TextBlock Text="{Binding RoleLabel}"
                               FontWeight="SemiBold"
                               Visibility="{Binding ShowsRoleLabel, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="원문 복사"
                            Padding="8,2"
                            HorizontalAlignment="Right"
                            Click="OnCopyAssistantMarkdown"
                            Visibility="{Binding IsAssistant, Converter={StaticResource BoolToVisibility}}"
                            ToolTipService.ToolTip="Markdown 원문 복사"
                            AutomationProperties.Name="Markdown 원문 복사" />
                    <local:MarkdownView Markdown="{Binding Text}"
                                        Visibility="{Binding IsActivity, Converter={StaticResource InverseBoolToVisibility}}" />
                    <Grid ColumnSpacing="6"
                          Visibility="{Binding IsActivity, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ProgressRing Width="14"
                                      Height="14"
                                      VerticalAlignment="Top"
                                      IsActive="{Binding IsRunning}"
                                      Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Text}"
                                   FontWeight="SemiBold"
                                   IsTextSelectionEnabled="True" />
                        <TextBlock Grid.Column="2" Text="—" />
                        <TextBlock Grid.Column="3"
                                   Text="{Binding Description}"
                                   TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True" />
                        <Button Grid.Column="4"
                                Content="{Binding ActivityToggleLabel}"
                                Padding="8,2"
                                VerticalAlignment="Top"
                                Click="OnToggleActivityDetails"
                                ToolTipService.ToolTip="도구 및 서브에이전트 상세 보기"
                                AutomationProperties.Name="{Binding ActivityToggleLabel}" />
                    </Grid>
                    <local:MarkdownView Margin="0,8,0,0"
                                        Markdown="{Binding Details}"
                                        Visibility="{Binding IsActivityExpanded, Converter={StaticResource BoolToVisibility}}" />
                    <Expander Header="상세"
                              Visibility="{Binding ShowsStandaloneDetails, Converter={StaticResource BoolToVisibility}}">
                        <local:MarkdownView Margin="0,8,0,0" Markdown="{Binding Details}" />
                    </Expander>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid x:Name="WorkspacePanel" Padding="40" MaxWidth="760" HorizontalAlignment="Center">
            <StackPanel VerticalAlignment="Center" Spacing="18">
                <FontIcon Glyph="&#xE8B7;" FontSize="44" HorizontalAlignment="Left" />
                <TextBlock Text="작업공간 선택" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Madi가 파일을 읽고 도구를 실행할 프로젝트 폴더를 선택하세요. 작업공간별로 대화가 분리됩니다."
                           TextWrapping="Wrap" Opacity="0.75" />
                <ListView x:Name="RecentWorkspaceList"
                          MinHeight="120"
                          MaxHeight="300"
                          SelectionMode="Single"
                          DoubleTapped="OnRecentWorkspaceDoubleTapped"
                          AutomationProperties.Name="최근 작업공간" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="선택한 폴더 열기" Click="OnOpenRecentWorkspace" />
                    <Button Content="다른 폴더 찾아보기" Click="OnBrowseWorkspace" />
                </StackPanel>
                <InfoBar x:Name="WorkspaceError" Severity="Error" IsOpen="False" IsClosable="True" />
            </StackPanel>
        </Grid>

        <Grid x:Name="Shell" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="380" MinWidth="180" MaxWidth="520" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" MinWidth="360" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition x:Name="WorkPanelColumn" Width="400" MinWidth="220" MaxWidth="640" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid Padding="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="대화" FontSize="20" FontWeight="SemiBold" Margin="6,6,6,12" />
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                        <Button Content="새 대화" Click="OnNewSessionMenu"
                                IsEnabled="{Binding CanInteract}"
                                ToolTipService.ToolTip="새 대화 유형 선택"
                                AutomationProperties.Name="새 대화 만들기" />
                        <Button Content="새 Work" Click="OnNewWork"
                                IsEnabled="{Binding CanInteract}"
                                AutomationProperties.Name="새 Work 만들기" />
                    </StackPanel>
                    <ListView x:Name="NavigationList"
                              Grid.Row="2"
                              ItemsSource="{Binding NavigationItems}"
                              ItemTemplate="{StaticResource NavigationTemplate}"
                              IsItemClickEnabled="True"
                              ItemClick="OnNavigationItemClick"
                              SelectionMode="Single"
                              IsEnabled="{Binding CanInteract}"
                              AutomationProperties.Name="작업공간 대화 목록" />
                    <Button Grid.Row="3" Content="작업공간 변경" Click="OnChangeWorkspace"
                            IsEnabled="{Binding CanInteract}" HorizontalAlignment="Stretch" />
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Padding="18,12" BorderThickness="0,0,0,1"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="240" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding HeaderTitle}" FontSize="20" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding WorkingDirectory}" FontSize="12" Opacity="0.65"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <ComboBox x:Name="ModelSelector" Grid.Column="1"
                                  ItemsSource="{Binding Models}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Name"
                                  SelectedValue="{Binding SelectedModelName, Mode=OneWay}"
                                  SelectionChanged="OnModelSelectionChanged"
                                  IsEnabled="{Binding CanInteract}"
                                  Header="모델"
                                  AutomationProperties.Name="모델 선택" />
                        <Button Grid.Column="2"
                                Content="{Binding AuthenticationLabel}"
                                Click="OnToggleAuthentication"
                                IsEnabled="{Binding CanInteract}"
                                VerticalAlignment="Bottom"
                                AutomationProperties.Name="로그인 상태" />
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1">
                    <InfoBar IsOpen="{Binding HasError, Mode=OneWay}"
                             Message="{Binding ErrorText}"
                             Severity="Error"
                             IsClosable="True"
                             CloseButtonClick="OnErrorClosed" />
                    <InfoBar x:Name="LegacyInfoBar"
                             Title="기존 대화 발견"
                             Message="작업공간 정보가 없는 기존 데이터를 현재 폴더에 연결할 수 있습니다."
                             Severity="Informational"
                             IsOpen="False"
                             IsClosable="True">
                        <InfoBar.ActionButton>
                            <Button Content="현재 작업공간에 연결" Click="OnImportLegacyData" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                </StackPanel>

                <Grid Grid.Row="2">
                    <ScrollViewer x:Name="TimelineScroller"
                                  IsTabStop="True"
                                  AllowFocusOnInteraction="True"
                                  UseSystemFocusVisuals="False"
                                  HorizontalScrollMode="Disabled"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollMode="Enabled"
                                  VerticalScrollBarVisibility="Auto"
                                  PreviewKeyDown="OnTimelinePreviewKeyDown"
                                  ViewChanged="OnTimelineViewChanged"
                                  AutomationProperties.Name="대화 타임라인">
                        <ItemsRepeater ItemsSource="{Binding Timeline}"
                                       ItemTemplate="{StaticResource TimelineTemplate}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Vertical" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </ScrollViewer>
                    <Button x:Name="LatestButton"
                            Content="최신으로 이동"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,12"
                            Click="OnGoLatest"
                            Visibility="Collapsed" />
                </Grid>

                <Grid Grid.Row="3" Padding="16,8,16,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ListView x:Name="SuggestionList"
                              ItemsSource="{Binding Suggestions}"
                              ItemTemplate="{StaticResource SuggestionTemplate}"
                              SelectionMode="Single"
                              MaxHeight="160"
                              Visibility="{Binding Suggestions.Count, Converter={StaticResource CountToVisibility}}"
                              DoubleTapped="OnSuggestionDoubleTapped" />
                    <Grid Grid.Row="1" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="PromptBox"
                                 Text="{Binding Draft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="48"
                                 MaxHeight="150"
                                 PlaceholderText="Madi에게 작업을 요청하세요"
                                 KeyDown="OnPromptKeyDown"
                                 AutomationProperties.Name="프롬프트 입력">
                            <TextBox.KeyboardAccelerators>
                                <KeyboardAccelerator Key="Enter"
                                                     Modifiers="Control"
                                                     Invoked="OnPromptSendAcceleratorInvoked" />
                            </TextBox.KeyboardAccelerators>
                        </TextBox>
                        <Button Grid.Column="1"
                                Content="{Binding SendButtonText}"
                                Click="OnSendOrCancel"
                                MinWidth="76"
                                VerticalAlignment="Stretch"
                                AutomationProperties.Name="전송 또는 취소" />
                    </Grid>
                </Grid>

            </Grid>

            <local:ColumnResizeCursorRegion Grid.Column="1">
                <primitives:Thumb DragDelta="OnLeftSplitterDragDelta"
                                  ToolTipService.ToolTip="드래그하여 대화 목록 너비 조절"
                                  AutomationProperties.Name="대화 목록 패널 크기 조절">
                    <primitives:Thumb.Template>
                        <ControlTemplate TargetType="primitives:Thumb">
                            <Grid Background="Transparent">
                                <Border Width="1"
                                        HorizontalAlignment="Center"
                                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            </Grid>
                        </ControlTemplate>
                    </primitives:Thumb.Template>
                </primitives:Thumb>
            </local:ColumnResizeCursorRegion>

            <local:ColumnResizeCursorRegion Grid.Column="3">
                <primitives:Thumb DragDelta="OnRightSplitterDragDelta"
                                  ToolTipService.ToolTip="드래그하여 Work 관리 패널 너비 조절"
                                  AutomationProperties.Name="Work 관리 패널 크기 조절">
                    <primitives:Thumb.Template>
                        <ControlTemplate TargetType="primitives:Thumb">
                            <Grid Background="Transparent">
                                <Border Width="1"
                                        HorizontalAlignment="Center"
                                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            </Grid>
                        </ControlTemplate>
                    </primitives:Thumb.Template>
                </primitives:Thumb>
            </local:ColumnResizeCursorRegion>

            <Border Grid.Column="4"
                    Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid Padding="12">
                    <Grid Visibility="{Binding HasCurrentWork, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Work 관리"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Margin="6,6,6,12" />
                        <TextBlock Grid.Row="1"
                                   Text="Work 프롬프트"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8" />
                        <TextBox Grid.Row="2"
                                 Text="{Binding WorkPromptDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalContentAlignment="Top"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 IsEnabled="{Binding CanInteract}"
                                 PlaceholderText="장기 목표, 제약 사항, 작업 원칙 등을 입력하세요."
                                 AutomationProperties.Name="Work 프롬프트 입력" />
                        <Grid Grid.Row="3" Margin="0,10,0,0" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="모든 대화에 적용됩니다."
                                       FontSize="12"
                                       Opacity="0.65"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    Content="저장"
                                    MinWidth="80"
                                    Style="{StaticResource AccentButtonStyle}"
                                    IsEnabled="{Binding CanSaveWorkPrompt}"
                                    Click="OnSaveWorkPrompt"
                                    AutomationProperties.Name="Work 프롬프트 저장" />
                        </Grid>
                    </Grid>

                    <StackPanel VerticalAlignment="Center"
                                Spacing="8"
                                Visibility="{Binding HasCurrentWork, Converter={StaticResource InverseBoolToVisibility}}">
                        <FontIcon Glyph="&#xE8A5;" FontSize="28" Opacity="0.5" />
                        <TextBlock Text="선택된 Work가 없습니다."
                                   TextAlignment="Center"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Work를 만들거나 Work에 속한 대화를 선택하면 프롬프트를 관리할 수 있습니다."
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Opacity="0.65" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Grid.ColumnSpan="5"
                    Padding="16,6"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="토큰 사용량"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding UsageText}"
                               FontSize="12"
                               Opacity="0.75"
                               TextTrimming="CharacterEllipsis"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               AutomationProperties.Name="토큰 사용량" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
